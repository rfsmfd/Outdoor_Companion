rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A reader may see another member's item if it's shared with a group the reader belongs to.
    // Membership is checked against the function-only mirror memberships/{uid}. .get(field, [])
    // everywhere so a missing field can't raise an error — an erroring rule on ANY doc a
    // collectionGroup query returns fails the whole query.
    function memberGroups() {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.get('groups', []);
    }
    function canReadShared() {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && resource.data.get('sharedGroups', []).hasAny(memberGroups());
    }

    // ---- Private per-user data: the owner can do anything with their own tree. ----
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Cross-member READ of shared items (Phase 3b) ----
    // CRITICAL: each shareable collection needs its OWN recursive-wildcard rule naming the
    // collection LITERALLY ( /{path=**}/<name>/... ). A single-segment {coll} wildcard does NOT
    // authorize a collectionGroup(<name>) query — it yields permission-denied. One block per
    // collection. Writes stay owner-only via the users/{uid} rule above (a member can read a
    // shared item but never write it — the app also hides edit controls on non-owned items).
    match /{path=**}/sites/{docId}        { allow read: if canReadShared(); }
    match /{path=**}/properties/{docId}   { allow read: if canReadShared(); }
    match /{path=**}/observations/{docId} { allow read: if canReadShared(); }
    match /{path=**}/trails/{docId}       { allow read: if canReadShared(); }
    match /{path=**}/cameras/{docId}      { allow read: if canReadShared(); }
    match /{path=**}/deployments/{docId}  { allow read: if canReadShared(); }
    match /{path=**}/bucks/{docId}        { allow read: if canReadShared(); }
    // Photos: the doc carries a self-authorizing download URL (token) for the full image, so sharing the
    // DOC is enough — no Storage-rules change needed for a member to open a shared photo full-size.
    match /{path=**}/photos/{docId}       { allow read: if canReadShared(); }
    // Phase 2a Suggester flow: a member writes a suggestion into THEIR OWN tree (owner rule above governs
    // the write), shares it to the group, and the target owner reads it here; the owner's approval/rejection
    // ack works the same way. Reads only — every write still lands in the writer's own tree.
    match /{path=**}/suggestions/{docId}    { allow read: if canReadShared(); }
    match /{path=**}/suggestionAcks/{docId} { allow read: if canReadShared(); }

    // ---- Membership mirror: readable by the user, written ONLY by Cloud Functions ----
    // Must live at the top level (not under users/{uid}) — the recursive owner rule above
    // would otherwise let a user forge their own group list and read any group's shared items.
    match /memberships/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Group metadata: members read; all mutations are function-only ----
    match /groups/{gid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if false; // createGroup function only (also seeds the membership mirror)
      allow delete: if false; // leaveGroup function only
      // Owner-side rename only; membership/owner/code stay frozen.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.memberUids == resource.data.memberUids
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.inviteCode == resource.data.inviteCode;

      // Legacy Phase-3a shared sub-tree (no longer written) — keep members-only so any leftover
      // test data is never world-readable. (Safe to remove later.)
      match /{coll}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
      }
    }
  }
}
